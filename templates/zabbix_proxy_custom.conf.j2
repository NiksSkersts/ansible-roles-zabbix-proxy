# Ansible managed: Do NOT edit this file manually!
# This is a configuration file for Zabbix Proxy process
# To get more information about Zabbix, visit http://www.zabbix.com
AllowRoot=0
AllowUnsupportedDBVersions=0
CacheSize=32M
ProxyConfigFrequency={{ zabbix_proxy_config_frequency }}
DataSenderFrequency={{ zabbix_proxy_data_sender_frequency }}
DBHost=localhost
DBName=/var/lib/zabbix/zabbix_proxy.db
DBPassword=zabbix_proxy
DBUser=zabbix_proxy
DebugLevel=3
EnableRemoteCommands=0
ExternalScripts=/usr/lib/zabbix/externalscripts
Fping6Location=/usr/bin/fping6
FpingLocation=/usr/bin/fping
HistoryCacheSize=16M
HistoryIndexCacheSize=4M
Hostname={{ inventory_hostname }}
HousekeepingFrequency=1
Include=/etc/zabbix/zabbix_proxy.d/*.conf
JavaGatewayPort=10052
ListenIP=0.0.0.0
ListenPort=10051
LoadModulePath=/usr/lib/zabbix/modules
LogFile=/var/log/zabbix/zabbix_proxy.log
LogFileSize=1
LogRemoteCommands=0
LogSlowQueries=0
LogType=file
PidFile=/var/run/zabbix/zabbix_proxy.pid
ProxyBufferMode={{ zabbix_proxy_buffer_mode }}
ProxyLocalBuffer=0
ProxyMemoryBufferAge={{ zabbix_proxy_memory_buffer_age }}
ProxyMemoryBufferSize={{ zabbix_proxy_memory_buffer_size }}
ProxyMode=0
ProxyOfflineBuffer={{ zabbix_proxy_offline_buffer }}
Server={{ zabbix_monitor_endpoint }}
SNMPTrapperFile=/tmp/zabbix_traps.tmp
SocketDir=/var/run/zabbix
#SourceIP={{ ansible_host }}
StartAgentPollers=1
StartBrowserPollers=1
StartDBSyncers=4
StartDiscoverers=5
StartHTTPAgentPollers=1
StartHTTPPollers=1
StartIPMIPollers=0
StartJavaPollers=0
StartODBCPollers=1
StartPingers=1
StartPollers=5
StartPollersUnreachable=1
StartPreprocessors=16
StartSNMPPollers=1
StartSNMPTrapper=0
StartTrappers=5
StartVMwareCollectors=0
StatsAllowedIP=127.0.0.1
Timeout={{ zabbix_proxy_timeout }}
TLSAccept=psk
TLSConnect=psk
TLSPSKFile={{ zabbix_proxy_tlspskfile }}
TLSPSKIdentity={{ zabbix_proxy_tlspskidentity }}
TmpDir=/tmp
TrapperTimeout=300
UnavailableDelay=60
UnreachableDelay=15
UnreachablePeriod=45
User=zabbix
VaultURL=https://127.0.0.1:8200
VMwareCacheSize=8M
VMwareFrequency=60
VMwarePerfFrequency=60
VMwareTimeout=10
